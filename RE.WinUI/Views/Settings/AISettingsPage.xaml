<Page
    x:Class="RE.WinUI.Views.Settings.AISettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:RE.WinUI.Views.Settings"
    mc:Ignorable="d"
    Background="Transparent"
    SizeChanged="Page_SizeChanged">

    <Grid>
        <ScrollViewer>
            <StackPanel x:Name="MainStackPanel" Spacing="4" HorizontalAlignment="Center" Padding="56,30,56,30">
                <TextBlock x:Name="DetailTitle" x:Uid="AISettingsTitle" Text="AI &amp; Models"
                           Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

                <!-- Antigravity Settings -->
                <controls:SettingsExpander x:Name="AntigravityExpander"
                                           x:Uid="AntigravityExpander"
                                           Header="Antigravity"
                                           Description="Google Deepmind"
                                           IsExpanded="True"
                                           ItemsSource="{x:Bind QuotaBuckets, Mode=OneWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="AntigravityAccountStatusProgress" Width="16" Height="16" IsActive="False"
                                      Visibility="Collapsed" />
                        <TextBlock x:Name="AntigravityAccountStatusText" x:Uid="AntigravityAccountStatusText" Text=""
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <controls:SettingsExpander.ItemsHeader>
                        <!-- Header & Refresh Button -->
                        <controls:SettingsCard x:Name="AntigravityQuotaHeaderCard" Header="Usage Quota"
                                               Description="Account rate limits and reset times">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="AntigravityQuotaProgress" Width="16" Height="16" IsActive="False"
                                              Visibility="Collapsed" />
                                <Button x:Name="AntigravityRefreshQuotaButton" Click="RefreshAntigravityQuota_Click"
                                        Padding="8,4" MinWidth="0" MinHeight="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        <TextBlock x:Name="AntigravityRefreshQuotaText" Text="Refresh Quota"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.ItemsHeader>

                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="local:QuotaBucketDisplayItem">
                            <controls:SettingsCard Header="{x:Bind DisplayName}" Description="{x:Bind ResetTimeText}">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <ProgressBar Value="{x:Bind RemainingPercent}" Maximum="100" Width="140"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind RemainingPercentText}" FontWeight="Medium" MinWidth="115"
                                               TextAlignment="Right" VerticalAlignment="Center" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                </controls:SettingsExpander>

                <!-- Ollama Settings -->
                <controls:SettingsExpander x:Name="OllamaExpander"
                                           x:Uid="OllamaExpander"
                                           Header="Ollama"
                                           Description="Local and Cloud Models"
                                           IsExpanded="True"
                                           ItemsSource="{x:Bind InstalledOllamaModels, Mode=OneWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE756;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <Button x:Name="OllamaViewUsageButton" x:Uid="OllamaViewUsageButton" Content="View Usage on Web"
                            Click="OllamaViewUsageButton_Click" />

                    <controls:SettingsExpander.ItemsHeader>
                        <StackPanel Spacing="0">
                            <controls:SettingsCard x:Name="OllamaPortCard" x:Uid="OllamaPortCard" Header="Ollama Port"
                                                   Description="Service port for local Ollama instance">
                                <TextBox x:Name="OllamaPortTextBox" Width="200" HorizontalAlignment="Right"
                                         PlaceholderText="11434" TextChanged="OllamaPortTextBox_TextChanged" />
                            </controls:SettingsCard>

                            <controls:SettingsCard x:Name="OllamaModelsHeaderCard" x:Uid="OllamaModelsCard"
                                                   Header="Installed models"
                                                   Description="Manage and download local Ollama models">
                                <Button x:Name="OllamaAddModelButton" x:Uid="OllamaAddModelButton"
                                        Style="{StaticResource AccentButtonStyle}" Click="AddOllamaModelButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock x:Name="OllamaAddModelButtonText" Text="Add Model" />
                                    </StackPanel>
                                </Button>
                            </controls:SettingsCard>
                        </StackPanel>
                    </controls:SettingsExpander.ItemsHeader>

                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="local:OllamaModelDisplayItem">
                            <controls:SettingsCard Header="{x:Bind Name}" Description="{x:Bind SizeFormatted}">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE9F9;" FontSize="16" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Tag="{x:Bind Name}" Padding="8,6,8,6" Background="Transparent"
                                        BorderThickness="0" Click="DeleteModel_Click"
                                        ToolTipService.ToolTip="Delete Model">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Button>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>

                    <controls:SettingsExpander.ItemsFooter>
                        <!-- Empty State Card -->
                        <controls:SettingsCard x:Name="OllamaNoModelsCard" Header="No models installed"
                                               Description="Click Add Model to pull a model." Visibility="Collapsed" />
                    </controls:SettingsExpander.ItemsFooter>
                </controls:SettingsExpander>

                <!-- API Keys & Providers Section -->
                <controls:SettingsExpander x:Name="ApiKeysExpander"
                                           x:Uid="ApiKeysExpander"
                                           Header="API keys &amp; Providers"
                                           Description="Manage API keys for cloud models and web search services"
                                           IsExpanded="True"
                                           ItemsSource="{x:Bind ConfiguredApiKeys, Mode=OneWay}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <Button x:Name="AddApiKeyButton" x:Uid="AddApiKeyButton" Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="AddApiKeyButton"
                            AutomationProperties.Name="Add API key"
                            Click="AddApiKeyButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock x:Name="AddApiKeyButtonText" Text="Add API Key" />
                        </StackPanel>
                    </Button>

                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="local:ApiKeyDisplayItem">
                            <controls:SettingsCard Header="{x:Bind Provider}" Description="{x:Bind MaskedKey}">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8D7;" FontSize="16" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button Tag="{x:Bind Id}" Padding="8,6,8,6" Background="Transparent"
                                        AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}"
                                        AutomationProperties.Name="Remove API key"
                                        BorderThickness="0" Click="DeleteApiKey_Click"
                                        ToolTipService.ToolTip="Remove API Key">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Button>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>

                    <controls:SettingsExpander.ItemsFooter>
                        <!-- Empty State Card -->
                        <controls:SettingsCard x:Name="NoApiKeysCard" Header="No API keys added"
                                               Description="Click Add API Key to configure cloud providers."
                                               Visibility="Collapsed" />
                    </controls:SettingsExpander.ItemsFooter>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
