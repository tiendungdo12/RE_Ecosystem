<Page
    x:Class="RE.WinUI.Views.Settings.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    SizeChanged="Page_SizeChanged">

    <ScrollViewer>
        <StackPanel x:Name="MainStackPanel" Spacing="4" HorizontalAlignment="Center" Padding="56,30,56,30">
            <TextBlock x:Name="DetailTitle" x:Uid="GeneralSettingsTitle" Text="General"
                       Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <!-- App Language -->
            <controls:SettingsCard x:Name="LanguageCard" x:Uid="LanguageCard" Header="Language"
                                   Description="Choose display language">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="LanguageComboBox" Width="200" MinWidth="200"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="LanguageDefault" Content="System Default" Tag="default" />
                    <ComboBoxItem Content="English" Tag="en-US" />
                    <ComboBoxItem Content="Tiếng Việt" Tag="vi-VN" />
                </ComboBox>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>