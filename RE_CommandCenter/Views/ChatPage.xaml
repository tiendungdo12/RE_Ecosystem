<Page
    x:Class="RE_CommandCenter.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:RE_CommandCenter.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="AI Command Center" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

        <!-- Output cua Giai doan 1: moi message trong ChatHistory duoc render thanh mot block chat. -->
        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ChatHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ChatMessage">
                        <StackPanel Margin="0,0,0,16" Padding="12" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" />

                                <!-- Copy nhanh noi dung cua tung message: dung de lay lai request/response JSON khi test tool. -->
                                <Button
                                    Grid.Column="1"
                                    Content="Copy"
                                    Tag="{Binding Content}"
                                    Click="CopyMessageButton_Click"
                                    Padding="8,2"
                                    MinWidth="0"
                                    MinHeight="0" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <ProgressRing Grid.Column="0" IsActive="True" Visibility="{Binding ThinkingVisibility}" Width="16" Height="16" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Content}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input cua Giai doan 1: TextBox cap nhat UserInput, Enter hoac Send goi SendMessageCommand. -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox 
                Text="{Binding UserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                PlaceholderText="Type your command..." 
                VerticalAlignment="Center" 
                Margin="0,0,12,0"
                AcceptsReturn="False"
                KeyDown="UserInputTextBox_KeyDown"/>
            
            <Button 
                Grid.Column="1" 
                Content="Send" 
                Command="{Binding SendMessageCommand}" 
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Center"/>
        </Grid>

        <!-- Toast nho xac nhan copy, dat floating tren UI va khong anh huong layout chat. -->
        <Border
            x:Name="CopyToast"
            Grid.RowSpan="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0"
            Padding="14,8"
            CornerRadius="6"
            Background="{ThemeResource SystemAccentColor}"
            Opacity="0"
            IsHitTestVisible="False">
            <TextBlock Text="Copied!" Foreground="White" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Page>
