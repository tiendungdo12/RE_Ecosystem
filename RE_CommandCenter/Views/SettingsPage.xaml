<Page
    x:Class="RE_CommandCenter.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="30" Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- App Theme -->
            <StackPanel Spacing="8">
                <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="ThemeComboBox" Header="App Theme" Width="200" SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="System Default" Tag="Default" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </StackPanel>

            <!-- Backdrop Material -->
            <StackPanel Spacing="8">
                <TextBlock Text="Window Material" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="BackdropComboBox" Header="Background Effect" Width="200" SelectionChanged="BackdropComboBox_SelectionChanged">
                    <ComboBoxItem Content="Mica (Windows 11)" Tag="Mica" />
                    <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                    <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                    <ComboBoxItem Content="None" Tag="None" />
                </ComboBox>
            </StackPanel>

            <!-- Accent Color -->
            <StackPanel Spacing="8">
                <TextBlock Text="Accent Color" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="SystemAccentToggle" 
                              Header="Use Windows System Accent Color" 
                              Toggled="SystemAccentToggle_Toggled" />
                
                <StackPanel x:Name="CustomColorPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="Custom Accent Color" />
                    <ColorPicker x:Name="AccentColorPicker" 
                                 ColorChanged="AccentColorPicker_ColorChanged" 
                                 IsColorSliderVisible="True" 
                                 IsColorChannelTextInputVisible="True" 
                                 IsHexInputVisible="True" 
                                 IsAlphaEnabled="False" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
