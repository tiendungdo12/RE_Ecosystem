<Page
    x:Class="RE_CommandCenter.Views.TriagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <TextBlock Text="Automated File Triage" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Select an executable to extract YARA, LIEF, Binwalk, and Authenticode metadata." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Action Section -->
        <controls:SettingsCard Grid.Row="1" Header="Target File" Description="Choose a local file to analyze">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8E5;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="FilePathBox" Width="400" PlaceholderText="C:\path\to\file.exe" IsReadOnly="True" />
                <Button x:Name="BrowseButton" Content="Browse" Click="BrowseButton_Click" />
                <Button x:Name="ScanButton" Content="Scan" Style="{StaticResource AccentButtonStyle}" Click="ScanButton_Click" IsEnabled="False" />
            </StackPanel>
        </controls:SettingsCard>

        <!-- Dashboard Section -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" x:Name="DashboardPanel" Visibility="Collapsed">
                    
                    <InfoBar x:Name="StatusBanner" IsOpen="True" Severity="Success" Title="Triage Complete" Message="All static analysis engines successfully processed the file." />

                    <controls:SettingsExpander Header="Identity &amp; Hashes" Description="Basic file properties and cryptographic hashes" IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8F1;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="File Size">
                                <TextBlock x:Name="FileSizeText" Text="0 bytes" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Magic Bytes">
                                <TextBlock x:Name="MagicText" FontFamily="Consolas" Text="4D 5A 90 00 ..." />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="MD5 Hash">
                                <TextBlock x:Name="Md5Text" FontFamily="Consolas" Text="N/A" IsTextSelectionEnabled="True" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="SHA256 Hash">
                                <TextBlock x:Name="Sha256Text" FontFamily="Consolas" Text="N/A" IsTextSelectionEnabled="True" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="Security &amp; Architecture" Description="Digital signatures, entropy, and architecture analysis" IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEA18;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="Authenticode Signature">
                                <Border x:Name="AuthBadge" Background="Transparent" CornerRadius="4" Padding="8,4">
                                    <TextBlock x:Name="AuthText" Text="Unknown" FontWeight="SemiBold" />
                                </Border>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Signer Subject">
                                <TextBlock x:Name="AuthSubjectText" Text="N/A" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Right" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Platform &amp; Arch">
                                <TextBlock x:Name="PlatformText" Text="Windows (x86_64)" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Overall Entropy">
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar x:Name="EntropyBar" Minimum="0" Maximum="8" Value="0" Width="150" />
                                    <TextBlock x:Name="EntropyText" Text="0.00" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Section Entropy">
                                <ListView x:Name="SectionList" SelectionMode="None" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4">
                                                <TextBlock Text="{Binding Name}" FontFamily="Consolas" Width="80" />
                                                <ProgressBar Minimum="0" Maximum="8" Value="{Binding Entropy}" Width="100" />
                                                <TextBlock Text="{Binding Entropy}" Width="50" />
                                                <TextBlock Text="{Binding RawSizeDisplay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="Protector &amp; Imports" Description="DIE and LIEF heuristics" IsExpanded="True">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE9F5;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="Protector / Packer (DIE)">
                                <TextBlock x:Name="PackerText" Text="None" TextWrapping="Wrap" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Suspicious Imports">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SuspiciousImportsText" Text="0" Foreground="Red" />
                                    <ListView x:Name="ImportsList" SelectionMode="None" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" Foreground="Red" Margin="0,2" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Recommended Pipeline">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,4">
                                    <TextBlock x:Name="PipelineText" Text="windows.clean_pe" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                </Border>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="Binwalk Deep Scan" Description="Embedded files and structural anomalies" IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8B9;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard>
                                <ListView x:Name="BinwalkList" SelectionMode="None" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8">
                                                <TextBlock Text="{Binding Offset}" FontFamily="Consolas" Foreground="{ThemeResource SystemFillColorCautionBrush}" Width="100" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="500" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <TextBox x:Name="RawJsonBox" Header="Raw JSON Output" Height="200" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" IsReadOnly="True" FontFamily="Consolas" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
